NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# MongoDB Atlas — replace with your cluster URI
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/citygym?retryWrites=true&w=majority

# JWT — generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_64_CHAR_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_64_CHAR_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OpenAI
OPENAI_API_KEY=sk-proj-your_production_openai_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000

# Stripe (live keys)
STRIPE_SECRET_KEY=sk_live_your_stripe_live_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# Firebase
FIREBASE_SERVER_KEY=your_production_firebase_server_key
FIREBASE_PROJECT_ID=your_firebase_project_id

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS — your deployed frontend / app domain
CORS_ORIGINS=https://app.citygym.com,https://citygym.com

# Rate limiting (stricter in prod)
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
