{
  "name": "ultimate-gym-backend",
  "version": "1.0.0",
  "description": "Backend API for Ultimate Gym System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "seed": "node seed.js",
    "demo": "node scripts/demo.js",
    "demo:reset": "node scripts/demo.js --reseed"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "testTimeout": 120000
  },
  "keywords": [
    "gym",
    "fitness",
    "api",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Ultimate Gym Team",
  "license": "MIT",
  "dependencies": {
    "apple-signin-auth": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.40.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.0.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.4",
    "openai": "^6.33.0",
    "recharts": "^3.8.1",
    "socket.io": "^4.7.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^29.6.4",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  }
}
