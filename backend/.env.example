# Database Configuration
MONGODB_URI=mongodb://localhost:27017/gymdb

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_REFRESH_SECRET=your-refresh-token-secret-here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URLs (for CORS)
CLIENT_URL=http://localhost:3000
MOBILE_URL=http://localhost:8080

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@gymapp.com

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: Redis for session storage (if using Redis)
# REDIS_URL=redis://localhost:6379

# Optional: Push notification keys (for mobile app)
# FCM_SERVER_KEY=your-fcm-server-key
# APNS_KEY_ID=your-apns-key-id
# APNS_TEAM_ID=your-apns-team-id
SOCKET_PORT=5001
# ── Coach Renas (all optional — placeholders until real merchant accounts exist) ──
# Only these coach e-mails may open the Coach Renas panel (comma list). Empty = every coach + admins.
COACH_RENAS_COACH_EMAILS=
# Account numbers shown to clients who pay 1-on-1 coaching by transfer
COACH_RENAS_TRANSFER_FIB=
COACH_RENAS_TRANSFER_QI=
COACH_RENAS_TRANSFER_ZAINCASH=
# Store billing (in-app tiers/programs) — verification not implemented yet
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APPLE_IAP_SHARED_SECRET=
# Direct gateways (not implemented yet — coach confirms payments by hand)
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET=
ZAINCASH_MSISDN=
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=
QI_MERCHANT_ID=
QI_API_KEY=
