NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# MongoDB (local dev)
MONGODB_URI=mongodb://127.0.0.1:27019/gymdb

# JWT
JWT_SECRET=dev_access_secret_replace_in_prod_64chars_minimum_length_required
JWT_REFRESH_SECRET=dev_refresh_secret_replace_in_prod_64chars_minimum_length_required
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000

# Stripe (test keys)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Firebase
FIREBASE_SERVER_KEY=your_firebase_server_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id

# Social Auth — Google (Web Client ID from Firebase Console → Project Settings → Web API Key)
GOOGLE_CLIENT_ID=your_google_web_client_id_here.apps.googleusercontent.com

# Social Auth — Apple
APPLE_BUNDLE_ID=com.citygym.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate limiting
RATE_LIMIT_MAX=200

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Logging
LOG_LEVEL=debug
